# 複製這個檔案為 .env 並填入真實的值，.env 不會被 git 追蹤。
# POSTGRES_PASSWORD / TWSTOCK_JWT_SECRET 建議用亂數字串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

POSTGRES_PASSWORD=change-me-to-a-strong-random-password
TWSTOCK_JWT_SECRET=change-me-to-a-long-random-string

TWSTOCK_INITIAL_CASH=1000000
TWSTOCK_POLL_INTERVAL_SECONDS=7
TWSTOCK_TRADING_START=09:00
TWSTOCK_TRADING_END=13:30
TWSTOCK_AFTER_HOURS_END=20:00

# 管理員登入帳密，登入頁用這組帳密即可進入 /admin 後台。
TWSTOCK_ADMIN_USERNAME=admin
TWSTOCK_ADMIN_PASSWORD=admin
